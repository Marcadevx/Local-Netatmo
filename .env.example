# Copy to .env. HomeKit's TCP port and device ID are discovered via mDNS.
NETATMO_HOST=192.168.1.100
HOST=127.0.0.1
PORT=3000
PAIRING_FILE=./data/pairing.json
CACHE_TTL_SECONDS=30
# Required when HOST is not a loopback address. Generate: openssl rand -hex 32
API_TOKEN=
# Optional discovery override (use BOTH, based on actual discovery output):
# NETATMO_DEVICE_ID=AA:BB:CC:DD:EE:FF
# NETATMO_PORT=12345
