{
  "name": "local-netatmo",
  "version": "0.1.0",
  "private": true,
  "description": "Read Netatmo weather measurements locally through HomeKit with Hono and Node.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "discover": "node --env-file-if-exists=.env src/cli.js discover",
    "pair": "node --env-file-if-exists=.env src/cli.js pair",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/cli.js && node --test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dns-packet": "^5.6.1",
    "hap-controller": "^0.10.2",
    "hono": "^4.13.13"
  },
  "license": "MIT"
}
